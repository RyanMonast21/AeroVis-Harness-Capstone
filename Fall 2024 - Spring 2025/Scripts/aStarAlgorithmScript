using System;
using System.Drawing;
using System.IO;
using System.Collections.Generic;
using System.Runtime.Versioning;
using static Program;

[SupportedOSPlatform("Windows")]
class Program
{
    static void Main(string[] args)
    {
        string inputImagePath = ""; // Input image path
        string outputTextFilePath = ""; // Output text file path
        string nodeCoordinatesFilePath = ""; // Node coordinates file path

        // 1. Convert image to binary matrix and save to text file
        int[,] binaryMatrix = ConvertImageBinaryMatrix(inputImagePath, outputTextFilePath);

        // 2. Save node coordinates to a file
        FindNodeCoordinates(binaryMatrix, nodeCoordinatesFilePath);

        // 3. Get desired destination user input
        char goalNode = GetGoalNodeFromUser();

        // 4. Use the binary matrix and stored coordinates for the A* Algorithm
        RunAStarAlgorithm(binaryMatrix, nodeCoordinatesFilePath, goalNode);
    }

    static char GetGoalNodeFromUser()
    {
        Console.WriteLine("Please select a goal node between A and N:");
        char input = char.ToUpper(Console.ReadKey().KeyChar); // Get user input and convert if not uppercase

        while (input < 'A' || input > 'N')
        {
            Console.WriteLine("\nInvalid input. Please enter a character between A and N.");
            input = char.ToUpper(Console.ReadKey().KeyChar);
        }

        Console.WriteLine($"\nSelected goal node: {input}");
        return input;
    }
    static int[,] ConvertImageBinaryMatrix(string imagePath, string outputFilePath)
    {
        Bitmap bitmap = new Bitmap(imagePath);
        int width = bitmap.Width;
        int height = bitmap.Height;

        int[,] binaryMatrix = new int[height, width];

        using (StreamWriter writer = new StreamWriter(outputFilePath))
        {
            for (int y = 0; y < height; y++)
            {
                for (int x = 0; x < width; x++)
                {
                    Color pixelColor = bitmap.GetPixel(x, y);

                    // Match pixel color to correlating end points
                    if (pixelColor.R == 120 && pixelColor.G == 120 && pixelColor.B == 255)
                    {
                        writer.Write("S");
                        binaryMatrix[y, x] = -1;
                    }
                    else if (pixelColor.R == 255 && pixelColor.G == 120 && pixelColor.B == 0)
                    {
                        writer.Write("A");
                        binaryMatrix[y, x] = -2; // Custom value for goal A
                    }
                    else if (pixelColor.R == 255 && pixelColor.G == 200 && pixelColor.B == 0)
                    {
                        writer.Write("B"); 
                        binaryMatrix[y, x] = -3; // Custom value for goal B
                    }
                    else if (pixelColor.R == 120 && pixelColor.G == 255 && pixelColor.B == 0)
                    {
                        writer.Write("C"); 
                        binaryMatrix[y, x] = -4; // Custom value for goal C
                    }
                    else if (pixelColor.R == 200 && pixelColor.G == 255 && pixelColor.B == 0)
                    {
                        writer.Write("D"); 
                        binaryMatrix[y, x] = -5; // Custom value for goal D
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 255 && pixelColor.B == 0)
                    {
                        writer.Write("E"); 
                        binaryMatrix[y, x] = -6; // Custom value for goal E
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 255 && pixelColor.B == 200)
                    {
                        writer.Write("F"); 
                        binaryMatrix[y, x] = -7; // Custom value for goal F
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 255 && pixelColor.B == 255)
                    {
                        writer.Write("G"); 
                        binaryMatrix[y, x] = -8; // Custom value for goal G
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 200 && pixelColor.B == 255)
                    {
                        writer.Write("H"); 
                        binaryMatrix[y, x] = -9; // Custom value for goal H
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 120 && pixelColor.B == 255)
                    {
                        writer.Write("I"); 
                        binaryMatrix[y, x] = -10; // Custom value for goal I
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 0 && pixelColor.B == 255)
                    {
                        writer.Write("J"); 
                        binaryMatrix[y, x] = -11; // Custom value for goal J
                    }
                    else if (pixelColor.R == 120 && pixelColor.G == 0 && pixelColor.B == 255)
                    {
                        writer.Write("K"); 
                        binaryMatrix[y, x] = -12; // Custom value for goal K
                    }
                    else if (pixelColor.R == 200 && pixelColor.G == 0 && pixelColor.B == 255)
                    {
                        writer.Write("L"); 
                        binaryMatrix[y, x] = -13; // Custom value for goal L
                    }
                    else if (pixelColor.R == 255 && pixelColor.G == 0 && pixelColor.B == 255)
                    {
                        writer.Write("M"); 
                        binaryMatrix[y, x] = -14; // Custom value for goal M
                    }
                    else if (pixelColor.R == 255 && pixelColor.G == 0 && pixelColor.B == 120)
                    {
                        writer.Write("N"); 
                        binaryMatrix[y, x] = -15; // Custom value for goal N
                    }
                    else if (pixelColor.R == 0 && pixelColor.G == 0 && pixelColor.B == 0)
                    {
                        writer.Write("1"); // Walkable space
                        binaryMatrix[y, x] = 1; // Custom value for walkable
                    }
                    else if (pixelColor.R == 255 && pixelColor.G == 255 && pixelColor.B == 255)
                    {
                        writer.Write("0"); // Unwalkable space
                        binaryMatrix[y, x] = 0; // Custom value for unwalkable
                    }
                }
                writer.WriteLine();
            }
        }

        Console.WriteLine("Binary matrix with color-based points saved to " + outputFilePath);
        return binaryMatrix;
    }
    public class Node
    {
        public int X { get; set; }
        public int Y { get; set; }
        public int GCost { get; set; } // Cost from the start node to this node
        public int HCost { get; set; } // Heuristic cost from this node to the goal node
        public int FCost => GCost + HCost; // Total cost of both nodes
        public Node Parent { get; set; }

        public Node(int x, int y)
        {
            X = x;
            Y = y;
            GCost = int.MaxValue; // Start with infinite cost
            HCost = 0;
            Parent = null;
        }

        // Override Equals and GetHashCode to compare Nodes correctly in HashSet
        public override bool Equals(object obj)
        {
            if (obj is Node other)
            {
                return X == other.X && Y == other.Y;
            }
            return false;
        }

        public override int GetHashCode()
        {
            return X.GetHashCode() ^ Y.GetHashCode(); // Combine X and Y coordinates for unique hashing
        }
    }

    static List<Node> GetNeighbors(Node node, int[,] grid)
    {
        List<Node> neighbors = new List<Node>();
        int[,] directions = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }; //Scan four directions for neighbors

        for (int i = 0; i < directions.GetLength(0); i++)
        {
            int newX = node.X + directions[i, 0];
            int newY = node.Y + directions[i, 1];

            if (newX >= 0 && newX < grid.GetLength(1) && newY >= 0 && newY < grid.GetLength(0))
            {
                if (grid[newY, newX] != 0) // Walkable space
                {
                    neighbors.Add(new Node(newX, newY)); // Correctly add the neighbor node
                }
            }
        }

        return neighbors;
    }


    static List<Node> FindPath(int[,] grid, Node startNode, Node goalNode)
    {
        var openList = new List<Node>();
        var closedList = new HashSet<Node>();

        startNode.GCost = 0;
        startNode.HCost = Math.Abs(startNode.X - goalNode.X) + Math.Abs(startNode.Y - goalNode.Y);

        openList.Add(startNode);

        while (openList.Count > 0)
        {
            Node currentNode = openList.OrderBy(n => n.FCost).First(); // Get node with lowest FCost
            openList.Remove(currentNode);  // Remove from open list as after processing

            if (currentNode.X == goalNode.X && currentNode.Y == goalNode.Y)
            {
                // Reached the goal, reconstruct the path
                var path = new List<Node>();
                while (currentNode != null)
                {
                    path.Add(currentNode);
                    currentNode = currentNode.Parent;
                }
                path.Reverse();
                return path;
            }

            closedList.Add(currentNode);

            foreach (var neighbor in GetNeighbors(currentNode, grid))
            {
                if (closedList.Contains(neighbor)) continue; // Skip if already processed

                int tentativeGCost = currentNode.GCost + 1; // Assume all steps cost 1

                // If this path is better, take it
                if (tentativeGCost < neighbor.GCost)
                {
                    neighbor.Parent = currentNode;
                    neighbor.GCost = tentativeGCost;
                    neighbor.HCost = Math.Abs(neighbor.X - goalNode.X) + Math.Abs(neighbor.Y - goalNode.Y); // Manhattan distance

                    if (!openList.Contains(neighbor))
                        openList.Add(neighbor);
                }
            }
        }

        return null; // No path found
    }

    static void FindNodeCoordinates(int[,] binaryMatrix, string outputFilePath)
    {
        var nodeValues = new Dictionary<int, char>
        {
            { -1, 'S' },  // Start node
            { -2, 'A' },  // Goal node A
            { -3, 'B' },  // Goal node B
            { -4, 'C' },  // Goal node C
            { -5, 'D' },  // Goal node D
            { -6, 'E' },  // Goal node E
            { -7, 'F' },  // Goal node F
            { -8, 'G' },  // Goal node G
            { -9, 'H' },  // Goal node H
            { -10, 'I' }, // Goal node I
            { -11, 'J' }, // Goal node J
            { -12, 'K' }, // Goal node K
            { -13, 'L' }, // Goal node L
            { -14, 'M' }, // Goal node M
            { -15, 'N' }, // Goal node N
        };

        using (StreamWriter writer = new StreamWriter(outputFilePath))
        {
            for (int y = 0; y < binaryMatrix.GetLength(0); y++)
            {
                for (int x = 0; x < binaryMatrix.GetLength(1); x++)
                {
                    int value = binaryMatrix[y, x];
                    if (nodeValues.ContainsKey(value))
                    {
                        writer.WriteLine($"{nodeValues[value]}:({x},{y})");
                    }
                }
            }
        }
        Console.WriteLine("Node coordinates saved to " + outputFilePath);
    }
    static void RunAStarAlgorithm(int[,] grid, string nodeCoordinatesFilePath, char goalNode)
    {
        Console.WriteLine("Running A* Algorithm...");

        // Read node coordinates from the file
        Dictionary<char, (int X, int Y)> nodeCoordinates = new Dictionary<char, (int X, int Y)>();
        foreach (var line in File.ReadAllLines(nodeCoordinatesFilePath))
        {
            var parts = line.Split(':');
            char nodeType = parts[0][0];
            var coordinates = parts[1].Trim('(', ')').Split(',');
            int x = int.Parse(coordinates[0]);
            int y = int.Parse(coordinates[1]);
            nodeCoordinates[nodeType] = (x, y);
        }

        // Check if Start node exists and selected Goal node exists
        if (!nodeCoordinates.ContainsKey('S') || !nodeCoordinates.ContainsKey(goalNode))
        {
            Console.WriteLine("Start or Goal node coordinates are missing.");
            return;
        }

        var startCoords = nodeCoordinates['S'];
        var goalCoords = nodeCoordinates[goalNode];

        Node startNode = new Node(startCoords.X, startCoords.Y);
        Node goalNodeInstance = new Node(goalCoords.X, goalCoords.Y);

        // Find the path using A* Algorithm
        List<Node> path = FindPath(grid, startNode, goalNodeInstance);

        if (path != null)
        {
            Console.WriteLine("Path found: ");
            foreach (var node in path)
            {
                // Print the coordinates in a manner that can be graphed
                Console.WriteLine($"({node.X}, -{node.Y})");
            }
        }
        else
        {
            Console.WriteLine("No path found.");
        }
    }
}